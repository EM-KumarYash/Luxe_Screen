# Copy this file to server/.env and adjust the values.

# PostgreSQL connection string.
# Docker users: keep as-is (matches docker-compose.yml).
# Installed PostgreSQL: replace the password (the second "postgres") with your own.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luxe_screens?schema=public"

# Port the API listens on.
PORT=4000

# Frontend URL(s) allowed to call the API (CORS). Comma-separated.
CLIENT_ORIGIN="http://localhost:5173"
