# Copy this file to .env.local (or .env) and adjust the values.
# Both the app and the Prisma CLI read .env.local first, then .env.

# PostgreSQL connection string.
# Docker users: keep as-is (matches docker-compose.yml).
# Local PostgreSQL users: replace the password with your own.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luxe_screens?schema=public"

# Public base URL of the app (used for absolute links/metadata).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
